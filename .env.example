# Model runtime selection (Ollama remains the default/reference provider)
MODEL_RUNTIME_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBED_MODEL=
OLLAMA_REQUEST_TIMEOUT_SECONDS=60
PLANNER_EVAL_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_MAX_EMBEDDING_BATCH=32
OLLAMA_MAX_RESPONSE_BYTES=4194304
OLLAMA_MAX_OUTPUT_TOKENS=2048

# OpenAI-compatible REST (required only when MODEL_RUNTIME_PROVIDER=openai_compatible)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_IDENTITY_PROFILE="openai_models_by_id"
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CHAT_MODEL=
OPENAI_COMPATIBLE_EMBED_MODEL=
OPENAI_COMPATIBLE_REQUEST_TIMEOUT_SECONDS=60
OPENAI_COMPATIBLE_MAX_RESPONSE_BYTES=4194304
OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=2048
OPENAI_COMPATIBLE_MAX_EMBEDDING_BATCH=32

# Application
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Analytics MySQL endpoint (synthetic local default or external read-only source)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=data_agent

# Runtime read-only principal
MYSQL_READONLY_USER=data_agent_reader
MYSQL_READONLY_PASSWORD=change-me-local-only

# Agent control-plane persistence (logically and network isolated from analytics data)
MYSQL_CONTROL_HOST=127.0.0.1
MYSQL_CONTROL_PORT=3306
MYSQL_CONTROL_DATABASE=data_agent_control
MYSQL_CONTROL_USER=data_agent_control
MYSQL_CONTROL_PASSWORD=change-me-local-only

# Local synthetic/control admin bootstrap only; not required by an external analytics source
MYSQL_ROOT_PASSWORD=change-me-local-only

# One active analytics source; external mode requires independent source/workspace identities
ANALYTICS_SOURCE_MODE=SYNTHETIC
ANALYTICS_SOURCE_ID=synthetic-reference
ANALYTICS_ALLOWED_TABLES='["dim_category","dim_channel","dim_product","dim_region","dim_user","fact_order","fact_order_item","fact_payment_transaction","fact_refund","fact_user_event"]'
ANALYTICS_CATALOG_WORKSPACE=synthetic-reference

# Runtime governance
MAX_QUERY_TIME_MS=5000
MAX_RESULT_ROWS=1000
MAX_RESULT_BYTES=8388608
MYSQL_QUERY_READ_TIMEOUT_SECONDS=10
MAX_SQL_CHARACTERS=64000
MAX_EXPLAIN_ESTIMATED_ROWS=100000
MAX_SQL_REPAIR_ATTEMPTS=1
MAX_RETRIEVED_TABLES=8
MAX_RELATIONSHIP_HOPS=1
RETRIEVAL_LEXICAL_TOP_K=10
RETRIEVAL_SEMANTIC_TOP_K=10
RETRIEVAL_SEED_TABLES=4
RETRIEVAL_RRF_K=60
MAX_ANSWER_CONTEXT_ROWS=100
MAX_ANSWER_CONTEXT_BYTES=131072
